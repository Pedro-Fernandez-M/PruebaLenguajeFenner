# --- Conexion a la base de datos ---
# Si esta linea esta comentada, la plataforma usa SQLite local (modo liceo).
# Para trabajar contra Supabase, descomentala y pega la cadena del
# "Transaction pooler" (puerto 6543), reemplazando [YOUR-PASSWORD] por la
# contrasena real de la base:
#
# DATABASE_URL=postgresql://postgres.TU-PROYECTO:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# Puerto del servidor local
PORT=3000

# Clave para firmar las cookies de sesion. CAMBIALA por una cadena larga y aleatoria.
SESSION_SECRET=cambia-esta-clave-por-algo-largo-y-aleatorio

# Ruta del archivo SQLite (solo modo local)
SQLITE_PATH=./data/dia.db

# Cuenta de profesor creada en el primer arranque
ADMIN_EMAIL=profesor@liceo.cl
ADMIN_PASSWORD=dia2026
ADMIN_NOMBRE=Docente
